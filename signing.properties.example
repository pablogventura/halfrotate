# Copy to signing.properties and fill in values (do not commit signing.properties).
# Generate keystore:
#   keytool -genkey -v -keystore halfrotate-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload

storeFile=halfrotate-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
